    "test:fixes": "node tests/critical_fixes.test.js",
    "test:ai": "node tests/ai_integration.test.js",
    "test:community": "node tests/community.test.js",
    "test:phase5": "node tests/phase5_hardening.test.js",
    "test:phase6": "node tests/phase6_mentorship.test.js",
    "test:phase7": "node --test tests/phase7_enrollment.test.js",
    "test:phase7_1": "node --test tests/phase7_1_safety.test.js",
    "test:phase7_2": "node --test tests/phase7_2_legacy_cert.test.js",
